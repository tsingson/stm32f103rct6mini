/* 位于：boards/stm32f103_mini.overlay */
/ {
	aliases {
		led-user = &led_pc7;
		button-user = &btn_pc6;
		modem-power = &pwr_4g;
		gps-power = &pwr_gps;
	};

	leds {
		compatible = "gpio-leds";
		led_pc7: led-pc7-node {
			gpios = <&gpioc 7 GPIO_ACTIVE_LOW>;
			label = "User LED PC7";
		};
		pwr_4g: pwr-4g-node {
			gpios = <&gpioc 8 GPIO_ACTIVE_HIGH>;
		};
		pwr_gps: pwr-gps-node {
			gpios = <&gpioc 9 GPIO_ACTIVE_HIGH>;
		};
	};

	buttons {
		compatible = "gpio-keys";
		btn_pc6: btn-pc6-node {
			gpios = <&gpioc 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "User Button PC6";
		};
	};
};

&usart2 {
	pinctrl-0 = <&usart2_tx_pa2 &usart2_rx_pa3>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&usart3 {
	pinctrl-0 = <&usart3_tx_pb10 &usart3_rx_pb11>;
	pinctrl-names = "default";
	current-speed = <9600>;
	status = "okay";
};

&i2c1 {
	pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
	pinctrl-names = "default";
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	ssd1306: ssd1306@3c {
		compatible = "solomon,ssd1306";
		reg = <0x3c>;
		width = <128>;
		height = <64>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		segment-remap;
		com-invdir;
		prechargep = <0x22>;
	};
};

&clk_hsi { status = "okay"; };
&pll { status = "disabled"; };
&rcc {
	clocks = <&clk_hsi>;
	clock-frequency = <DT_FREQ_M(8)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
};


&spi1 {
	status = "okay";
	cs-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;

	lis3dsh: lis3dsh@0 {
		compatible = "st,lis3dsh";
		reg = <0>;
		spi-max-frequency = <1000000>;
		status = "okay";
	};
};
